{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductionInput",
  "type": "object",
  "properties": {
    "demands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Demand"
      }
    },
    "problem": {
      "$ref": "#/$defs/Problem"
    },
    "workplans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Workplan"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "problem",
    "workplans",
    "demands"
  ],
  "$defs": {
    "Activity": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "reservations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reservation"
          }
        },
        "role": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Segment"
          }
        },
        "start": {
          "type": "integer",
          "format": "int64"
        },
        "task": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "task",
        "role",
        "mode",
        "start",
        "end",
        "segments",
        "reservations"
      ]
    },
    "ActivityDependency": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string"
        },
        "max_lag": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "min_lag": {
          "type": "integer",
          "format": "int64",
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "before"
      ]
    },
    "Basis": {
      "type": "string",
      "enum": [
        "work",
        "productive_time",
        "occupied_time",
        "elapsed_time"
      ]
    },
    "CompletionObjective": {
      "description": "Minimize sum(attribute * completion), with a unit coefficient when omitted.\nThe existing attribute objective supplies both the metric and its documented Q.",
      "type": "object",
      "properties": {
        "attribute": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "select": {
          "$ref": "#/$defs/Selector",
          "default": {
            "families": [],
            "stages": [],
            "tasks": []
          }
        },
        "weight": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "weight"
      ]
    },
    "Conditional": {
      "type": "object",
      "properties": {
        "after": {
          "description": "None retains legacy serial order. Some([]) starts an independent branch.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "$ref": "#/$defs/ActivityDependency"
          }
        },
        "id": {
          "type": "string"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mode"
          }
        },
        "owner_resource": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "releases_product": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "modes"
      ]
    },
    "Constraint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "eligible_resources"
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "select": {
              "$ref": "#/$defs/Selector"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "select",
            "resources"
          ]
        },
        {
          "type": "object",
          "properties": {
            "earliest": {
              "type": "integer",
              "format": "int64"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "window"
            },
            "latest": {
              "type": "integer",
              "format": "int64"
            },
            "select": {
              "$ref": "#/$defs/Selector"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "select",
            "earliest",
            "latest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "consecutive": {
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "sequence"
            },
            "resource": {
              "type": "string"
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "resource",
            "tasks",
            "consecutive"
          ]
        }
      ]
    },
    "CustomizationRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "Demand": {
      "type": "object",
      "properties": {
        "deadline": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "due": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "id": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "max_lot": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "predecessors": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "number",
          "format": "double"
        },
        "quantity": {
          "type": "number",
          "format": "double"
        },
        "selected_workplan": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "workplans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "item",
        "quantity",
        "workplans",
        "priority"
      ]
    },
    "Dependency": {
      "type": "object",
      "properties": {
        "after": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "max_lag": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "min_lag": {
          "type": "integer",
          "format": "int64",
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ]
    },
    "Execution": {
      "type": "object",
      "properties": {
        "actual": {
          "description": "Actual main activity segments and reservations; retained as immutable facts.",
          "$ref": "#/$defs/Activity"
        },
        "as_of": {
          "type": "integer",
          "format": "int64"
        },
        "mode": {
          "type": "string"
        },
        "remaining_work": {
          "description": "One entry per phase. Explicit zero marks completed phases/preparation.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "restart": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Conditional"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "as_of",
        "actual",
        "remaining_work"
      ]
    },
    "FreezeZone": {
      "type": "object",
      "properties": {
        "baseline_schedule": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "until": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "until",
        "dimensions",
        "tasks",
        "baseline_schedule"
      ]
    },
    "InitialCampaign": {
      "type": "object",
      "properties": {
        "credit": {
          "type": "number",
          "format": "double"
        },
        "family": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "credit"
      ]
    },
    "Interrupt": {
      "type": "string",
      "enum": [
        "non_interruptible",
        "calendar_resumable"
      ]
    },
    "Job": {
      "type": "object",
      "properties": {
        "deadline": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "due": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "id": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "priority": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "quantity": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "item",
        "quantity"
      ]
    },
    "Lock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mode"
            },
            "mode": {
              "type": "string"
            },
            "task": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resource"
            },
            "resource": {
              "type": "string"
            },
            "task": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "resource"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "integer",
              "format": "int64"
            },
            "kind": {
              "type": "string",
              "const": "start"
            },
            "task": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "consecutive": {
              "type": "boolean",
              "default": false
            },
            "kind": {
              "type": "string",
              "const": "order"
            },
            "resource": {
              "type": "string"
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "resource",
            "tasks"
          ]
        }
      ]
    },
    "MaterialPolicy": {
      "type": "string",
      "enum": [
        "reallocate_routes"
      ]
    },
    "Mode": {
      "type": "object",
      "properties": {
        "consume": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": null
        },
        "contiguous": {
          "type": "boolean",
          "default": false
        },
        "cost": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "id": {
          "type": "string"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Phase"
          }
        },
        "post": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Conditional"
          }
        },
        "pre": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Conditional"
          }
        },
        "primary": {
          "type": "string"
        },
        "produce": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "primary",
        "phases"
      ]
    },
    "NoMatch": {
      "type": "string",
      "enum": [
        "allow_switch",
        "fail"
      ]
    },
    "Objective": {
      "type": "object",
      "properties": {
        "maximize": {
          "type": "boolean",
          "default": false
        },
        "metric": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "scale": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "weight": {
          "type": "number",
          "format": "double",
          "default": 1.0
        }
      },
      "additionalProperties": false,
      "required": [
        "metric"
      ]
    },
    "Order": {
      "type": "object",
      "properties": {
        "deadline": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "due": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "id": {
          "type": "string"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "number",
          "format": "double",
          "default": 1.0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "jobs"
      ]
    },
    "Phase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "interruption": {
          "$ref": "#/$defs/Interrupt",
          "default": "non_interruptible"
        },
        "rate_resource": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Requirement"
          }
        },
        "work": {
          "description": "None remains a readiness error, never zero work.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "work_per_unit": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "requirements"
      ]
    },
    "PlanningModel": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "objectives": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/CompletionObjective"
          }
        },
        "policies": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Policy"
          }
        },
        "version": {
          "type": "string",
          "default": "apex.planning.v1"
        }
      },
      "additionalProperties": false
    },
    "Policy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "basis": {
              "$ref": "#/$defs/Basis"
            },
            "continue_after_minimum": {
              "type": "boolean",
              "default": false
            },
            "exempt_committed": {
              "type": "boolean",
              "default": false
            },
            "id": {
              "type": "string"
            },
            "initial": {
              "anyOf": [
                {
                  "$ref": "#/$defs/InitialCampaign"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "kind": {
              "type": "string",
              "const": "campaign"
            },
            "minimum": {
              "type": "number",
              "format": "double"
            },
            "on_no_match": {
              "$ref": "#/$defs/NoMatch"
            },
            "resource": {
              "type": "string"
            },
            "select": {
              "$ref": "#/$defs/Selector",
              "default": {
                "families": [],
                "stages": [],
                "tasks": []
              }
            },
            "urgent_slack": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "resource",
            "minimum",
            "basis",
            "on_no_match"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fallback_to_smallest": {
              "description": "Explicit fallback to the smallest feasible gap when all exceed the limit.",
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "idle_gap"
            },
            "maximum": {
              "type": "integer",
              "format": "int64"
            },
            "resource": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "resource",
            "maximum",
            "fallback_to_smallest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "urgency"
            },
            "resource": {
              "type": "string"
            },
            "slack": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "resource",
            "slack"
          ]
        }
      ]
    },
    "Problem": {
      "type": "object",
      "properties": {
        "assumptions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "customization": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomizationRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dependencies": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Dependency"
          }
        },
        "epoch": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "freeze_zones": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FreezeZone"
          }
        },
        "horizon": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "inventory": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "default": {}
        },
        "jobs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Job"
          }
        },
        "locks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Lock"
          }
        },
        "material_policy": {
          "description": "Reallocate existing supply after selecting an active workplan for each evaluation.",
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "objectives": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Objective"
          }
        },
        "orders": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Order"
          }
        },
        "planning": {
          "$ref": "#/$defs/PlanningModel",
          "default": {
            "constraints": [],
            "objectives": [],
            "policies": [],
            "version": "apex.planning.v1"
          }
        },
        "queue_definitions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/QueueDefinition"
          }
        },
        "queue_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueuePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "receipts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Receipt"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          }
        },
        "routes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteChoice"
          }
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Rule"
          }
        },
        "schema_version": {
          "type": "string",
          "default": "apex.v3.4"
        },
        "tasks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "transitions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Transition"
