{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Options",
  "type": "object",
  "properties": {
    "budget_ms": {
      "type": "integer",
      "format": "uint64",
      "default": 5000,
      "minimum": 0
    },
    "conditional_choices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "decision_order": {
      "description": "Soft operation priority permutation. Readiness and mandatory policies still apply.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_prefix": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Decision"
      }
    },
    "improve": {
      "$ref": "#/$defs/ImproveConfig",
      "default": {
        "policies": 3,
        "xe_share": 0.0,
        "xh_share": 0.4
      }
    },
    "iterations": {
      "type": "integer",
      "format": "uint",
      "default": 128,
      "minimum": 0
    },
    "mode_choices": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "queue_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueuePolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "route_choices": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "seed": {
      "type": "integer",
      "format": "uint64",
      "default": 42,
      "minimum": 0
    },
    "strategy": {
      "type": "string",
      "default": "due"
    },
    "top_k": {
      "type": "integer",
      "format": "uint",
      "default": 1,
      "minimum": 0
    },
    "weights": {
      "anyOf": [
        {
          "$ref": "#/$defs/HeuristicWeights"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "xe": {
      "description": "XE direct schedule evolution configuration.",
      "$ref": "#/$defs/XeConfig",
      "default": {
        "crossover_share": 0.5,
        "discount": 0.99,
        "exploration": 1.0,
        "parent_selection": "tournament",
        "population_size": null,
        "random_share": 0.1,
        "selection": "discounted_ucb"
      }
    },
    "xh": {
      "description": "XH hypersearch configuration; shared population/worker defaults also serve XE.",
      "$ref": "#/$defs/XhConfig",
      "default": {
        "archive_limit": 32,
        "crossover_rate": 0.25,
        "generations": null,
        "max_evaluations": null,
        "mutation_rate": 0.75,
        "population_size": 16,
        "selection": "lexicographic",
        "workers": 1
      }
    },
    "xt": {
      "description": "XT tree-search configuration.",
      "$ref": "#/$defs/XtConfig",
      "default": {
        "branching": 4,
        "depth": 8,
        "exploration": 1.4,
        "workers": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Decision": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "task": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "task",
        "mode"
      ]
    },
    "HeuristicWeights": {
      "type": "object",
      "properties": {
        "due": {
          "type": "number",
          "format": "double"
        },
        "priority": {
          "type": "number",
          "format": "double"
        },
        "release": {
          "type": "number",
          "format": "double"
        },
        "urgency": {
          "type": "number",
          "format": "double"
        },
        "work": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "due",
        "work",
        "priority",
        "release",
        "urgency"
      ]
    },
    "ImproveConfig": {
      "type": "object",
      "properties": {
        "policies": {
          "description": "Maximum number of distinct validated strategies handed to XT.",
          "type": "integer",
          "format": "uint",
          "default": 3,
          "minimum": 0
        },
        "xe_share": {
          "description": "Reserve part of the same total budget for XE.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "xh_share": {
          "description": "Fraction of the shared evaluation/time allowance assigned to XH.",
          "type": "number",
          "format": "double",
          "default": 0.4
        }
      },
      "additionalProperties": false
    },
    "QueuePolicy": {
      "type": "object",
      "properties": {
        "candidate_limit": {
          "description": "Zero evaluates the entire ready set; a positive value bounds the candidate window.",
          "type": "integer",
          "format": "uint",
          "default": 64,
          "minimum": 0
        },
        "normalization": {
          "type": "string",
          "default": "minmax"
        },
        "stages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            }
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "XeConfig": {
      "type": "object",
      "properties": {
        "crossover_share": {
          "description": "None lets all eligible operator kinds compete in the bandit.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": 0.5
        },
        "discount": {
          "type": "number",
          "format": "double",
          "default": 0.99
        },
        "exploration": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "parent_selection": {
          "type": "string",
          "default": "tournament"
        },
        "population_size": {
          "description": "None preserves the caller's existing XH population setting.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "random_share": {
          "type": "number",
          "format": "double",
          "default": 0.1
        },
        "selection": {
          "type": "string",
          "default": "discounted_ucb"
        }
      },
      "additionalProperties": false
    },
    "XhConfig": {
      "type": "object",
      "properties": {
        "archive_limit": {
          "type": "integer",
          "format": "uint",
          "default": 32,
          "minimum": 0
        },
        "crossover_rate": {
          "type": "number",
          "format": "double",
          "default": 0.25
        },
        "generations": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "max_evaluations": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "mutation_rate": {
          "type": "number",
          "format": "double",
          "default": 0.75
        },
        "population_size": {
          "type": "integer",
          "format": "uint",
          "default": 16,
          "minimum": 0
        },
        "selection": {
          "type": "string",
          "default": "lexicographic"
        },
        "workers": {
          "type": "integer",
          "format": "uint",
          "default": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "XtConfig": {
      "type": "object",
      "properties": {
        "branching": {
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "format": "uint",
          "default": 8,
          "minimum": 0
        },
        "exploration": {
          "type": "number",
          "format": "double",
          "default": 1.4
        },
        "workers": {
          "type": "integer",
          "format": "uint",
          "default": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}