.apex/
.codex/
.vscode/
.idea/
.vs/
*.code-workspace
*.user
*.suo

# Dependencies, compiled output and caches
target/
node_modules/
.venv/
venv/
env/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
build/
dist/
*.py[cod]
*.pyd
*.so
*.dll
*.exe
*.pdb
*.obj
*.rlib
*.rmeta
*.o
*.a
*.lib

# Temporary files, runtime locks, logs and local databases
tmp/
temp/
*.tmp
*.tmp.*
*.temp
