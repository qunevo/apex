Thumbs.db

# Dependency resolution is source metadata, not a runtime lock.
!/Cargo.lock
!/package-lock.json

# Generated test and measurement output (migration evidence is in docs/migration-audit.md)
/docs/reports/*
!/docs/reports/.gitignore
coverage/
htmlcov/
.coverage*
coverage.xml
test-results/
playwright-report/
*.prof
*.lprof
*.onnx
*.faiss
*.pkl
*.pickle
*.pt
*.pth
checkpoints/
embeddings/
.ipynb_checkpoints/
*.zip
*.7z
*.tar
*.tar.gz

# Publish the frozen benchmark only as its reviewed ZIP and reader's guide.
/benchmark/*
!/benchmark/README.md
!/benchmark/apex-benchmark-2026-09-24.zip

# Historical benchmark plans and helper outputs remain excluded.
/docs/benchmark-experiment-plan.md
/scripts/benchmark_*.py
/scripts/report_*.py
